# ─────────────────────────────────────────────────────────────────────────
#  stellaris-mac-fixes — .gitignore
#
#  Philosophy:
#    - Source files, scripts, docs, and the Makefile are tracked.
#    - Built artifacts and release outputs are NOT tracked — they're
#      regenerated by `make` / `make release` and attached to GitHub
#      releases as binary downloads.
#    - macOS, editor, and OS metadata is excluded by default.
#    - Defensive defaults exclude common credential / secret patterns
#      even though this project shouldn't have any.
# ─────────────────────────────────────────────────────────────────────────

# ── Build artifacts ──────────────────────────────────────────────────────
# Generated by `make` and `make release`. Regenerable from source.

libstellaris_fix.dylib
test_interpose
*.o
*.a
*.so
*.dylib
*.bundle
*.dSYM/

# ── Release outputs ──────────────────────────────────────────────────────
# Generated by `make release`. The release zip is uploaded to GitHub
# releases, not committed to the repo.

stellaris-mac-fixes.zip
*.zip
CHECKSUMS.txt
RELEASE_CHECKSUMS.txt

# ── Backup files from sed -i (created during `make checksums`) ───────────

*.bak
*.orig

# ── macOS metadata ───────────────────────────────────────────────────────

.DS_Store
.AppleDouble
.LSOverride
._*
Icon
Icon?
.Spotlight-V100
.Trashes
.fseventsd
.TemporaryItems
.VolumeIcon.icns
.com.apple.timemachine.donotpresent
.AppleDB
.AppleDesktop
Network Trash Folder
Temporary Items
.apdisk

# ── Windows metadata (defensive) ─────────────────────────────────────────

Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/

# ── Linux metadata (defensive) ───────────────────────────────────────────

*~
.fuse_hidden*
.directory
.Trash-*
.nfs*

# ── Editor / IDE files ───────────────────────────────────────────────────

# Vim
*.swp
*.swo
*.swn
.*.sw[a-p]
Session.vim
.netrwhist
tags
.tags

# Emacs
\#*\#
.\#*

# VSCode
.vscode/
*.code-workspace

# JetBrains (CLion / IntelliJ)
.idea/
*.iml
*.iws

# Xcode
*.xcodeproj/
*.xcworkspace/
xcuserdata/
DerivedData/
*.moved-aside
*.pbxuser
!default.pbxuser
*.mode1v3
!default.mode1v3
*.mode2v3
!default.mode2v3
*.perspectivev3
!default.perspectivev3

# Sublime Text
*.sublime-project
*.sublime-workspace

# ── Logs and temporary files ─────────────────────────────────────────────

*.log
*.tmp
*.temp
tmp/
temp/
.cache/

# ── Security: credentials, keys, secrets ─────────────────────────────────
# This project does NOT use any of these. They're listed here as
# defensive defaults to prevent accidental commits if future contributors
# add config files, credentials, or signing material.

# Environment files
.env
.env.*
!.env.example
!.env.template

# Private keys and certificates
*.pem
*.key
*.crt
*.cer
*.der
*.p12
*.pfx
*.jks
*.keystore

# SSH keys
id_rsa
id_rsa.*
id_dsa
id_dsa.*
id_ecdsa
id_ecdsa.*
id_ed25519
id_ed25519.*
*.ppk

# GPG / PGP
secring.*
pubring.*
*.gpg
*.asc
!CHECKSUMS.txt.asc

# Code signing (Apple)
*.mobileprovision
*.provisionprofile
*.cer
*.p12
*.certSigningRequest
embedded.mobileprovision

# Cloud provider credentials
.aws/
credentials
.azure/
.gcloud/
gcloud-service-key.json
service-account-*.json

# Common secret filenames
secret
secrets
secrets.*
*.secret
*.secrets
credentials.*
*_credentials.*
*_token.*
*.token
*_apikey.*
*.apikey
auth.json
.npmrc
.pypirc
.netrc

# ── Project-specific dev artifacts ───────────────────────────────────────
# Add anything else generated by local development workflows here.

# Personal Stellaris paths or test outputs (local-only)
.stellaris-test/
local-*.sh
test-output/
